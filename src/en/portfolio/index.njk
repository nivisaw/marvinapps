<section class="page-hero hero-bg" aria-labelledby="page-title">
  <div class="container">
    <span class="eyebrow">Portfolio</span>
    <h1 id="page-title">Software that already solves real problems</h1>
    <p>Each product was born from deeply understanding an industry. That's also how I approach custom projects.</p>
  </div>
</section>
<section class="section" aria-label="Portfolio">
  <div class="container"><div class="grid-2 products-lg"><article class="card product-card reveal" id="yoyo">
  <div class="product-media"><img src="/assets/img/yoyo.webp" alt="YOYO logo: stylized motorcycle forming the word YOYO" width="624" height="390" loading="lazy" decoding="async"></div>
  <div class="product-body">
    <span class="product-cat">Workshop management</span>
    <h2>YOYO</h2>
    <p>Management system for motorcycle maintenance workshops.</p>
    <a class="link-arrow" href="/en/portfolio/yoyo/" aria-label="View case: YOYO">View case <svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
  </div>
</article><article class="card product-card reveal" id="tata">
  <div class="product-media contain media-navy"><img src="/assets/img/tata.webp" alt="TATA logo: coffee cup with a paw print and the word tata" width="625" height="234" loading="lazy" decoding="async"></div>
  <div class="product-body">
    <span class="product-cat">Point of sale</span>
    <h2>TATA</h2>
    <p>The point of sale built for coffee shops and bars.</p>
    <a class="link-arrow" href="/en/portfolio/tata/" aria-label="View case: TATA">View case <svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
  </div>
</article><article class="card product-card reveal" id="lavatronic">
  <div class="product-media"><img src="/assets/img/lavatronic.webp" alt="Car wash worker using LAVATRONIC on a phone next to a foam-covered car" width="624" height="388" loading="lazy" decoding="async"></div>
  <div class="product-body">
    <span class="product-cat">Car wash management</span>
    <h2>LAVATRONIC</h2>
    <p>The management system for car and motorcycle washes.</p>
    <a class="link-arrow" href="/en/portfolio/lavatronic/" aria-label="View case: LAVATRONIC">View case <svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
  </div>
</article><article class="card product-card reveal" id="cheeky">
  <div class="product-media"><img src="/assets/img/cheeky.webp" alt="CHEEKY character: smiling purple devil next to a die and a wine glass" width="625" height="388" loading="lazy" decoding="async"></div>
  <div class="product-body">
    <span class="product-cat">18+ multiplayer game</span>
    <h2>CHEEKY</h2>
    <p>A digital board game for adults, real-time and in 3D.</p>
