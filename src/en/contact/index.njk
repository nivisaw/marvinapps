---
<section class="page-hero hero-bg" aria-labelledby="page-title">
  <div class="container">
    <span class="eyebrow">Contact</span>
    <h1 id="page-title">Let's talk about your project</h1>
    <p>The first consultation is free. I usually reply the same business day.</p>
  </div>
</section>
<section class="section" aria-label="Contact">
  <div class="container contact-grid">
    <div>
      <div class="contact-cards">
        <a class="card contact-card" href="https://wa.me/573214012236" target="_blank" rel="noopener"><span class="icon-chip"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></span><div><strong>WhatsApp</strong><span>+57 321 401 2236</span></div></a>
        <a class="card contact-card" href="https://www.linkedin.com/in/marvindelgado" target="_blank" rel="noopener me"><span class="icon-chip"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></span><div><strong>LinkedIn</strong><span>/in/marvindelgado</span></div></a>
      </div>
      <p class="contact-note"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg> Bogotá, Colombia · Remote service across Latin America</p>
    </div>
    <form class="card form-card" id="contact-form" aria-label="Contact form" novalidate>
      <div class="form-row">
        <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" type="text" autocomplete="name" required></div>
        <div class="field"><label for="f-company">Company (optional)</label><input id="f-company" name="company" type="text" autocomplete="organization"></div>
      </div>
      <div class="field"><label for="f-need">What do you need?</label><select id="f-need" name="need"><option value="">Choose an option</option><option>Custom software</option><option>Web apps and SaaS</option><option>Integrations and APIs</option><option>Cloud architecture and backend</option><option>Consulting and digital transformation</option><option>Support and evolution</option><option>Other / not sure yet</option></select></div>
      <div class="field"><label for="f-msg">Briefly tell me about your idea or problem</label><textarea id="f-msg" name="message" required></textarea></div>
      <button class="btn btn-primary btn-block" type="submit"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg> Send via WhatsApp</button>
      <p class="form-hint">WhatsApp will open with your message ready to send.</p>
    </form>
  </div>
</section>
